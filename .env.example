# Copy to .env.local for local development, and set these in your hosting
# provider's environment variables for production.

# Enquiries are handled by the embedded LeadConnector form on /contact, so
# there is no contact-form webhook to configure. Submissions land in the firm's
# LeadConnector account.

# Set to 1 to render the stock photo candidates in lib/images.js instead of the
# branded gradient placeholders.
NEXT_PUBLIC_USE_STOCK_IMAGES=

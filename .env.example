# Copy to .env.local for local development, and set these in your hosting
# provider's environment variables for production.

# Enquiries are handled by the embedded LeadConnector form on /contact, so
# there is no contact-form webhook to configure. Submissions land in the firm's
# LeadConnector account.

# Set to 1 to render the stock photo candidates in lib/images.js instead of the
# branded gradient placeholders.
NEXT_PUBLIC_USE_STOCK_IMAGES=

# --- Blog (RankGPT → /api/rankgpt-webhook → Supabase) ------------------------
# Shared secret RankGPT sends as `Authorization: Bearer <secret>` or
# `X-API-Key: <secret>`. Generate a long random value and paste the same one
# into RankGPT's webhook settings. Never commit the real value.
RANKGPT_WEBHOOK_SECRET=

# Supabase project holding the `blog_articles` table and the `blog-images`
# storage bucket (schema: supabase/migrations). Server-side only — do NOT add a
# NEXT_PUBLIC_ prefix to either of these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Storage bucket for article images; defaults to blog-images.
SUPABASE_BLOG_BUCKET=

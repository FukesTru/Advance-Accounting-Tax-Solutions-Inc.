# Copy to .env.local for local development, and set these in your hosting
# provider's environment variables for production.

# Where contact form submissions are POSTed as JSON (Zapier, Make, a CRM inbound
# hook, or an email-sending function). Until this is set, /api/contact returns
# 503 and the form tells visitors to call or email instead — deliberate, so no
# enquiry is silently lost.
CONTACT_WEBHOOK_URL=

# Set to 1 to render the stock photo candidates in lib/images.js instead of the
# branded gradient placeholders.
NEXT_PUBLIC_USE_STOCK_IMAGES=
